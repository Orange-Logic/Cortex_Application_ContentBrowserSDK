{
  "name": "@orangelogic/orange-dam-content-browser-sdk",
  "version": "2.1.0",
  "description": "OrangeDAM Content Browser SDK source code",
  "main": "./build/OrangeDAMContentBrowserSDK.min.js",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.mjs",
      "require": "./build/OrangeDAMContentBrowserSDK.min.js",
      "default": "./build/index.mjs"
    },
    "./content-browser": {
      "types": "./build/content-browser.d.ts",
      "import": "./build/content-browser.mjs",
      "default": "./build/content-browser.mjs"
    },
    "./build/OrangeDAMContentBrowserSDK.min.css": "./build/OrangeDAMContentBrowserSDK.min.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "build"
  ],
  "author": "Orange Logic",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "start": "vite",
    "build": "npm run build:library && npm run build:types",
    "build:library": "vite build && vite build -c vite.esm.config.ts && vite build -c vite.content-browser.esm.config.ts",
    "build:types": "node ./scripts/emit-types.mjs",
    "optimize": "vite optimize --force",
    "test-browser": "web-test-runner",
    "format": "eslint --fix .",
    "lint": "tsc --noEmit && eslint src/**/*.ts{,x}",
    "publish:library": "./scripts/publishIfNeeded.mjs"
  },
  "devDependencies": {
    "@remcovaes/web-test-runner-vite-plugin": "^1.2.2",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.4",
    "@semantic-release/npm": "^10.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/mocha": "^10.0.10",
    "@types/webfontloader": "^1.6.35",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@web/dev-server-rollup": "^0.6.4",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.1",
    "ajv": "^8.9.0",
    "eslint": "^8.46.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "2.28.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "glob": "^10.3.3",
    "sinon": "^21.0.3",
    "standard": "^17.1.0",
    "terser": "^5.39.0",
    "tsc-alias": "^1.8.10",
    "vite": "^6.2.5",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "@lit-labs/virtualizer": "^2.1.1",
    "@open-wc/testing": "^4.0.0",
    "@orangelogic/design-system": "2.91.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/node": "^20.4.8",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "async-mutex": "^0.4.0",
    "axios": "^1.14.0",
    "axios-cache-interceptor": "^1.12.0",
    "browserslist": "^4.18.1",
    "lit": "^3.3.1",
    "lodash-es": "^4.17.21",
    "react": "^19.0.0",
    "react-app-polyfill": "^3.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "styled-components": "^6.0.7",
    "typescript": "^5.1.6",
    "webfontloader": "^1.6.28"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "nyc": {
    "all": true,
    "excludeAfterRemap": true,
    "include": [
      "src/**/*.{ts,tsx}"
    ],
    "exclude": [
      "src/store/**/*",
      "src/__tests__/**/*",
      "src/**/*.d.ts",
      "src/types/**/*",
      "src/utils/api.ts",
      "src/AppContext.ts",
      "src/page/Home/**/*",
      "src/view/**/*"
    ],
    "check-coverage": true,
    "branches": 70,
    "functions": 90,
    "lines": 80,
    "statements": 80
  },
  "publishConfig": {
    "access": "public"
  }
}
